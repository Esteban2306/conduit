      "expect": { "toolsForbidden": ["crear_reserva_whatsapp", "actualizar_perfil_cliente"] } },
    { "id": "b30", "category": "persona", "title": "Hablar con una persona",
      "turns": [{ "actor": "A", "messages": [{ "text": "Quiero hablar con una persona por favor" }] }],
      "expect": { "toolsAll": ["pasar_a_persona"] } },
