{
  "version": 1,
  "notes": "Banco de conversaciones de Leonice Spa. 'prior' se siembra en Leonice antes de empezar; 'turns' se inyectan como mensajes de WhatsApp; 'expect' se evalúa al final. 'knownFailure' marca casos que hoy deben fallar (A1 turnos cortados/vacíos, A2 promesa falsa de persona, C3 fecha desconocida).",
  "scenarios": [
    { "id": "b01", "category": "saludo", "title": "Saludo simple",
      "turns": [{ "actor": "A", "messages": [{ "text": "Hola buenas tardes" }] }],
      "expect": { "route": "IA", "toolsForbidden": ["crear_reserva_whatsapp", "cancelar_reserva_whatsapp"] } },
    { "id": "b02", "category": "saludo", "title": "Saludo con nombre de clienta recurrente",
      "prior": { "client": { "name": "Marcela Ríos", "birthDate": "1988-03-14" } },
      "turns": [{ "actor": "A", "messages": [{ "text": "Buenos días! soy Marcela" }] }],
      "expect": { "route": "IA" } },
    { "id": "b03", "category": "gracias", "title": "Gracias tras una respuesta (se ignora salvo que el bot haya preguntado)",
