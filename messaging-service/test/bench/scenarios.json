        { "actor": "A", "messages": [{ "text": "Quiero hacerme un alisado, nunca he ido, ¿cómo es el proceso?" }] }
      ],
      "expect": { "toolsAny": ["listar_tratamientos"], "replyMatches": "valoraci" } },
    { "id": "b16", "category": "mis-citas", "title": "Ver mis citas (tiene una)",
      "prior": { "client": { "name": "Paola Castro", "birthDate": "1992-01-30" }, "reservations": [{ "treatment": "Terapia de nutrición", "daysFromNow": 3, "hour": 10, "status": "CONFIRMADA", "deposit": "CONFIRMADO" }] },
      "turns": [{ "actor": "A", "messages": [{ "text": "¿Para cuándo tengo mi cita?" }] }],
      "expect": { "toolsAll": ["reservas_proximas"], "replyMatches": "nutrici" } },
