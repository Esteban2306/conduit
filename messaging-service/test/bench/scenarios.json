    { "id": "b06", "category": "precios", "title": "Precio de un tratamiento",
      "turns": [{ "actor": "A", "messages": [{ "text": "¿Cuánto cuesta el alisado?" }] }],
      "expect": { "toolsAny": ["listar_tratamientos"], "replyMatches": "250" } },
    { "id": "b07", "category": "precios", "title": "Precio de uñas",
      "turns": [{ "actor": "A", "messages": [{ "text": "cuanto valen las uñas acrilicas" }] }],
      "expect": { "toolsAny": ["listar_tratamientos"], "replyMatches": "100" } },
    { "id": "b08", "category": "horarios", "title": "Horario de atención",
      "turns": [{ "actor": "A", "messages": [{ "text": "¿A qué hora abren los sábados?" }] }],
      "expect": { "toolsAny": ["info_negocio"] } },
    { "id": "b09", "category": "ubicacion", "title": "Ubicación",
      "turns": [{ "actor": "A", "messages": [{ "text": "Me pasas la dirección por favor" }] }],
      "expect": { "toolsAny": ["info_negocio"] } },
    { "id": "b10", "category": "disponibilidad", "title": "Disponibilidad un día de la semana",
      "turns": [{ "actor": "A", "messages": [{ "text": "¿Tienen espacio para hidratación el viernes?" }] }],
      "expect": { "toolsAny": ["consultar_disponibilidad", "disponibilidad_combo"] } },
    { "id": "b11", "category": "disponibilidad", "title": "Disponibilidad mañana",
      "turns": [{ "actor": "A", "messages": [{ "text": "hay cupo mañana para spa coreano?" }] }],
      "expect": { "toolsAny": ["consultar_disponibilidad", "disponibilidad_combo"] } },
