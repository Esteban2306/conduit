      "turns": [{ "actor": "A", "messages": [{ "text": "¿Qué día es hoy? y tienen cupo pasado mañana para hidratación?" }] }],
      "expect": { "replyNotMatches": "no (tengo|puedo).{0,40}fecha|qué (día|fecha) es hoy|me confirmas? la fecha", "toolsAny": ["consultar_disponibilidad", "disponibilidad_combo"] } },
    { "id": "b13", "category": "agendar", "title": "Agendar sin valoración, clienta nueva",
      "turns": [
        { "actor": "A", "messages": [{ "text": "Quiero agendar una terapia de hidratación" }] },
        { "actor": "A", "messages": [{ "text": "el próximo martes en la mañana" }] },
        { "actor": "A", "messages": [{ "text": "a las 9 está bien" }] },
        { "actor": "A", "messages": [{ "text": "Soy Laura Gómez, nací el 2 de febrero de 1995. Acepto los términos, no tengo alergias ni estoy embarazada" }] },
        { "actor": "A", "messages": [{ "text": "sí, confirmo" }] }
