        { "actor": "A", "messages": [{ "text": "gracias" }], "expect": { "route": "acuse" } }
      ],
      "expect": { "toolsAny": ["info_negocio"] } },
    { "id": "b04", "category": "gracias", "title": "Gracias en frío",
      "turns": [{ "actor": "A", "messages": [{ "text": "Muchas gracias" }], "expect": { "route": "ignorado" } }],
      "expect": {} },
