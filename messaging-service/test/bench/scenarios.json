      "expect": { "toolsAll": ["reservas_proximas", "cancelar_reserva_whatsapp"], "finalState": { "reservationStatus": "CANCELADA" } } },
    { "id": "b20", "category": "cancelar", "title": "Cancelar (\"cancélame la cita\") + sí corto",
